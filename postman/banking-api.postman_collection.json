{
  "info": {
    "name": "Banking API",
    "description": "REST API for the banking account management system. Run requests in the 'Happy path' folder in order for an end-to-end demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "00000000-0000-0000-0000-000000000001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "personId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "transactionId", "value": "" }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "1. Get seeded person (set personId manually first run)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/persons/{{personId}}",
              "host": ["{{baseUrl}}"],
              "path": ["persons", "{{personId}}"]
            }
          }
        },
        {
          "name": "2. Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accountId', json.id);",
                  "pm.test('account created', () => pm.expect(pm.response.code).to.eql(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personId\": \"{{personId}}\",\n  \"dailyWithdrawalLimit\": 2000.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "3. Deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00,\n  \"description\": \"Initial deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "deposit"]
            }
          }
        },
        {
          "name": "4. Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "balance"]
            }
          }
        },
        {
          "name": "5. Withdraw",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100.00\n}" },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "withdraw"]
            }
          }
        },
        {
          "name": "6. Statement (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/statement?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "statement"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        },
        {
          "name": "7. Statement (by period)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/statement?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "statement"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "8. Block account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Manual review\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "block"]
            }
          }
        }
      ]
    },
    {
      "name": "Error scenarios",
      "item": [
        {
          "name": "Deposit on blocked account (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50\n}" },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "deposit"]
            }
          }
        },
        {
          "name": "Withdraw insufficient funds (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 999999\n}" },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "withdraw"]
            }
          }
        },
        {
          "name": "Negative amount (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": -10\n}" },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "deposit"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "Readiness",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] } }
        }
      ]
    }
  ]
}
